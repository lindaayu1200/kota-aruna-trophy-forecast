": "bronze", "points": 15, "secret": true}, {"id": 28, "name": "Positive Mental Attitude", "description": "Meditate at every spot across Leonida.", "tier": "bronze", "points": 15, "secret": false}, {"id": 29, "name": "Fair Game", "description": "Hunt a unique animal for Bret.", "tier": "bronze", "points": 15, "secret": true}, {"id": 30, "name": "Don't Touch My Deck", "description": "Complete 3 Collectible Card sets.", "tier": "silver", "points": 30, "secret": false}, {"id": 31, "name": "You WAiNKer!", "description": "WAiNK It at 100 locations.", "tier": "silver", "points": 30, "secret": false}, {"id": 32, "name": "One Last Thing", "description": "Complete 50 Challenges.", "tier": "bronze", "points": 15, "secret": false}, {"id": 33, "name": "Hot Together", "description": "Lose a 4 star Wanted Level with your partner and escape the heat.", "tier": "bronze", "points": 15, "secret": false}, {"id": 34, "name": "Retail Therapy", "description": "Rob 3 shops back-to-back with your partner without losing your Wanted Level.", "tier": "bronze", "points": 15, "secret": false}, {"id": 35, "name": "Whip It Good", "description": "Discover 100 vehicles.", "tier": "bronze", "points": 15, "secret": false}, {"id": 36, "name": "Gunslinger", "description": "Take down 5 enemies in a single use of Combat Focus.", "tier": "bronze", "points": 15, "secret": false}, {"id": 37, "name": "Catch Me If You Can", "description": "Make an unscheduled departure at VCIA.", "tier": "bronze", "points": 15, "secret": true}, {"id": 38, "name": "Challenging Tank", "description": "Kinda hot in these Rhinos.", "tier": "bronze", "points": 15, "secret": true}, {"id": 39, "name": "Sneakthief", "description": "Rob a jewelry store without being detected.", "tier": "bronze", "points": 15, "secret": false}, {"id": 40, "name": "Maximum Withdrawal", "description": "Rob 5 Bank Vaults and escape.", "tier": "silver", "points": 30, "secret": false}, {"id": 41, "name": "A Classic Blitz Play", "description": "Rob an Armored Truck and escape.", "tier": "bronze", "points": 15, "secret": false}, {"id": 42, "name": "The Goodtime State", "description": "Explore all of Leonida.", "tier": "bronze", "points": 15, "secret": false}, {"id": 43, "name": "Pest Control", "description": "Rob an Illegal Operation belonging to each gang.", "tier": "bronze", "points": 15, "secret": false}, {"id": 44, "name": "In The Beginning\u2026", "description": "Enjoy a cocktail with a view on Ocean Beach.", "tier": "bronze", "points": 15, "secret": true}, {"id": 45, "name": "Capital Offense", "description": "Smash your way out of a vehicle showroom in classic style.", "tier": "bronze", "points": 15, "secret": true}, {"id": 46, "name": "Let\u2019s Go Bowling", "description": "Follow-through at the Kolt & Associates' bowling alley.", "tier": "bronze", "points": 15, "secret": true}, {"id": 47, "name": "Personal Best", "description": "A partnership with mass appeal.", "tier": "bronze", "points": 15, "secret": true}, {"id": 48, "name": "Actions Speak Louder", "description": "Choices made (for better or worse).", "tier": "bronze", "points": 15, "secret": true}, {"id": 49, "name": "Bad Luck, I Guess", "description": "Second time's the charm.", "tier": "bronze", "points": 15, "secret": true}, {"id": 50, "name": "The Truth Is Out There", "description": "What the hell just happened?", "tier": "bronze", "points": 15, "secret": true}, {"id": 51, "name": "Ten Pin", "description": "Bowl 'em over with a melee drive-by.", "tier": "bronze", "points": 15, "secret": true}, {"id": 52, "name": "Dime on the Dollar", "description": "Earn $250,000 laundering Marked Bills through your contacts.", "tier": "bronze", "points": 15, "secret": false}, {"id": 53, "name": "Treat Yo Self", "description": "Spend $100,000 across all shops.", "tier": "bronze", "points": 15, "secret": false}, {"id": 54, "name": "Little Boxes", "description": "Purchase all garage properties.", "tier": "bronze", "points": 15, "secret": false}, {"id": 55, "name": "On the Spot", "description": "Register 10 vehicles to the Scooter Bros app.", "tier": "bronze", "points": 15, "secret": false}], "history": [{"slot": "2026-11-19T04:30:00Z", "at": "2026-11-19T04:30:00Z", "players_tracked": 3868, "trophies_earned": 4254, "rates": [0.24, 100.0, 0.47, 0.41, 0.41, 0.41, 0.41, 0.41, 0.41, 0.41, 0.41, 0.41, 0.41, 0.24, 0.24, 0.29, 0.24, 0.24, 0.29, 0.76, 0.35, 0.29, 0.29, 0.29, 0.24, 0.24, 0.29, 0.24, 0.29, 0.24, 0.24, 0.24, 0.35, 0.29, 0.47, 0.29, 0.35, 0.59, 0.35, 0.29, 0.35, 0.29, 0.29, 0.35, 0.29, 0.29, 0.29, 0.29, 0.29, 0.29, 0.29, 0.29, 0.35, 0.29, 0.29]}, {"slot": "2026-11-19T04:40:00Z", "at": "2026-11-19T04:40:00Z", "players_tracked": 3882, "trophies_earned": 4271, "rates": [0.24, 100.0, 0.47, 0.41, 0.41, 0.41, 0.41, 0.41, 0.41, 0.41, 0.41, 0.41, 0.41, 0.24, 0.24, 0.29, 0.24, 0.24, 0.29, 0.77, 0.35, 0.29, 0.29, 0.29, 0.24, 0.24, 0.29, 0.24, 0.29, 0.24, 0.24, 0.24, 0.35, 0.29, 0.47, 0.29, 0.35, 0.59, 0.35, 0.29, 0.35, 0.29, 0.29, 0.35, 0.29, 0.29, 0.29, 0.29, 0.29, 0.29, 0.29, 0.29, 0.35, 0.29, 0.29]}, {"slot": "2026-11-19T04:50:00Z", "at": "2026-11-19T04:50:00Z", "players_tracked": 3897, "trophies_earned": 4287, "rates": [0.24, 100.0, 0.47, 0.41, 0.41, 0.41, 0.41, 0.41, 0.41, 0.41, 0.41, 0.41, 0.41, 0.24, 0.24, 0.29, 0.24, 0.24, 0.29, 0.77, 0.35, 0.29, 0.29, 0.29, 0.24, 0.24, 0.29, 0.24, 0.29, 0.24, 0.24, 0.24, 0.35, 0.29, 0.47, 0.29, 0.35, 0.59, 0.35, 0.29, 0.35, 0.29, 0.29, 0.35, 0.29, 0.29, 0.29, 0.29, 0.29, 0.29, 0.29, 0.29, 0.35, 0.29, 0.29]}, {"slot": "2026-11-19T05:00:00Z", "at": "2026-11-19T05:00:00Z", "players_tracked": 3912, "trophies_earned": 4303, "rates": [0.24, 100.0, 0.47, 0.42, 0.42, 0.42, 0.42, 0.42, 0.42, 0.42, 0.42, 0.42, 0.42, 0.24, 0.24, 0.29, 0.24, 0.24, 0.29, 0.77, 0.36, 0.29, 0.29, 0.29, 0.24, 0.24, 0.29, 0.24, 0.29, 0.24, 0.24, 0.24, 0.36, 0.29, 0.47, 0.29, 0.36, 0.59, 0.36, 0.29, 0.36, 0.29, 0.29, 0.36, 0.29, 0.29, 0.29, 0.29, 0.29, 0.29, 0.29, 0.29, 0.36, 0.29, 0.29]}, {"slot": "2026-11-19T05:10:00Z", "at": "2